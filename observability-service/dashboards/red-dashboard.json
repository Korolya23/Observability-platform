{
  "dashboard": {
    "title": "Микросервисы: RED Дашборд",
    "uid": "red-dashboard",
    "timezone": "browser",
    "panels": [
      {
        "title": "Частота запросов (Rate)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(http_server_duration_milliseconds_count[5m])",
            "legendFormat": "{{method}} {{endpoint}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "title": "Ошибки (Errors)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(http_server_errors_total[5m])",
            "legendFormat": "{{method}} {{endpoint}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "title": "Длительность запросов p95 (Duration)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_server_duration_milliseconds_bucket[5m])) by (le))",
            "legendFormat": "p50",
            "refId": "B"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          }
        }
      },
      {
        "title": "Логи приложения",
        "type": "logs",
        "datasource": "Loki",
        "targets": [
          {
            "expr": "{service=~\"$service\"}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 16}
      }
    ],
    "templating": {
      "list": [
        {
          "name": "service",
          "type": "query",
          "datasource": "Loki",
          "query": "label_values(service)",
          "multi": true,
          "includeAll": true,
          "label": "Сервис"
        }
      ]
    },
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "refresh": "10s"
  }
}