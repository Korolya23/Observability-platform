{
  "dashboard": {
    "title": "Microservices RED Dashboard",
    "uid": "red-dash",
    "panels": [
      {
        "title": "Request Rate per Service",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(http_server_duration_milliseconds_count[5m])) by (service)",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "title": "Error Rate (5xx)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(http_server_duration_milliseconds_count{http_status_code=~\"5..\"}[5m])) by (service)",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "title": "p95 Latency",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket[5m])) by (le, service))",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
      },
      {
        "title": "Logs (filtered by time and optional service)",
        "type": "logs",
        "datasource": "Loki",
        "targets": [
          {
            "expr": "{service=~\"$service\"}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 16}
      }
    ],
    "templating": {
      "list": [
        {
          "name": "service",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(http_server_duration_milliseconds_count, service)",
          "multi": true,
          "includeAll": true,
          "label": "Service"
        }
      ]
    },
    "time": {"from": "now-15m", "to": "now"},
    "refresh": "10s"
  }
}